# Copia este archivo como .env y completa solo las claves que tengas.
# Sin claves, la app funciona con yfinance (gratis, con retraso).

# https://finnhub.io  (plan gratis: 60 consultas/min, solo precio actual de EE.UU.)
FINNHUB_API_KEY=

# https://twelvedata.com  (plan gratis: 8 consultas/min, 800/día)
TWELVEDATA_API_KEY=

# https://www.alphavantage.co  (plan gratis: 25 consultas/día)
ALPHAVANTAGE_API_KEY=

# Fase 4 (opcional): alertas por Telegram y correo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
