# Copia este archivo como .env y completa lo que necesites.
# Todo es OPCIONAL: sin nada configurado la app funciona con yfinance.

# --- Datos de mercado (Twelve Data) ---
# Clave gratuita en https://twelvedata.com (plan Basic: 8 peticiones/min, 800/día).
TWELVE_DATA_API_KEY=

# --- Alertas por Telegram ---
# 1) Crea un bot con @BotFather y copia el token.
# 2) Escribe a tu bot y obtén tu chat id (p. ej. con @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# BOT DE EJECUCIÓN AUTOMÁTICA (bot.py / iniciar_bot.bat)
# ============================================================
# Modo: paper (simulado, sin riesgo) → demo (cuenta demo MT5) → real (dinero real)
BOT_MODE=paper
# Para operar en REAL debes escribir exactamente: SI_ENTIENDO_EL_RIESGO
BOT_CONFIRM_REAL=

# Estrategia y riesgo
BOT_ENTRY_THRESHOLD=70
BOT_RISK_PCT=0.5
BOT_SL_ATR_MULT=1.5
BOT_TP_ATR_MULT=3.0
BOT_ATR_TF=1h

# Protecciones
BOT_MAX_OPEN_POSITIONS=3
BOT_MAX_INDEX_POSITIONS=2
BOT_MAX_METAL_POSITIONS=1
BOT_MAX_TRADES_PER_DAY=6
BOT_MAX_DAILY_LOSS_PCT=2.0
BOT_MAX_SPREAD_ATR_RATIO=0.15

# Funcionamiento
BOT_LOOP_SECONDS=30
BOT_PAPER_BALANCE=10000
# auto = precios de MT5 si está instalado; si no, Twelve Data/yfinance. mt5 | feed para forzar.
BOT_DATA_SOURCE=auto
BOT_NOTIFY_TELEGRAM=true

# ============================================================
# METATRADER 5 (opcional)
# ============================================================
# Si lo dejas vacío, el bot usa la cuenta con la que ya iniciaste sesión en el terminal MT5.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Ruta a terminal64.exe si tienes varios MT5 instalados
MT5_PATH=
# Nombres de símbolo si la detección automática falla (ejemplos):
# MT5_SYMBOL_GOLD=XAUUSD
# MT5_SYMBOL_US500=US500.cash
# MT5_SYMBOL_US100=NAS100
# MT5_SYMBOL_US30=US30
# MT5_SYMBOL_US2000=US2000
